# NexHealth backend — Render production environment template
#
# HOW TO USE:
# 1. Copy:  cp .env.render.example render.env
# 2. Fill in CHANGE_ME values (render.env is gitignored)
# 3. Render Dashboard → Web Service → Environment → "Add from .env"
# 4. Select render.env (visible filename — dotfiles are hidden in file pickers)
# 5. Redeploy

ENVIRONMENT=production
DEBUG=false

DATABASE_URL=postgresql+asyncpg://postgres.CHANGE_ME:CHANGE_ME@aws-0-CHANGE_ME.pooler.supabase.com:5432/postgres
DB_SSL=true
DB_SSL_VERIFY=false

JWT_SECRET=CHANGE_ME
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
PASSWORD_RESET_TTL_MINUTES=30

COOKIE_DOMAIN=
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

CORS_ORIGINS=https://CHANGE_ME.vercel.app
FRONTEND_URL=https://CHANGE_ME.vercel.app
BACKEND_URL=https://CHANGE_ME.vercel.app

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

AZURE_TENANT_ID=common
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

OKTA_DOMAIN=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=

SEED_ADMIN_EMAIL=admin@betterdental.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_SUPER_ADMIN_EMAIL=platform@nexhealth.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!

SES_ENABLED=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=noreply@yourdomain.com
SES_FROM_NAME=NextHealth
INVITE_TTL_HOURS=72

EHR_CREDENTIALS_KEY=
EHR_SYNC_DEMO_MODE=false

OPEN_DENTAL_DEVELOPER_KEY=
OPEN_DENTAL_API_BASE_URL=https://api.opendental.com
