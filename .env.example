# ─────────────────────────────────────────────────────────────────────────────
# NexHealth backend — environment configuration
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# --- Runtime ---
ENVIRONMENT=development              # development | production
DEBUG=true

# --- Database ---
# Development: local Postgres (see docker-compose.yml)
# Production:  AWS RDS Postgres endpoint (use sslmode=require)
DATABASE_URL=postgresql+asyncpg://nexhealth:nexhealth@localhost:5434/nexhealth
# Example production value (AWS RDS):
# DATABASE_URL=postgresql+asyncpg://appuser:CHANGE_ME@your-db.abc123.us-east-1.rds.amazonaws.com:5432/nexhealth
# Example Supabase value (Session pooler — IPv4-friendly; URL-encode special
# chars in the password, e.g. @ -> %40, ! -> %21):
# DATABASE_URL=postgresql+asyncpg://postgres.<ref>:PASS@aws-0-<region>.pooler.supabase.com:5432/postgres

# Require TLS to the database. false for local Postgres; TRUE for Supabase / RDS.
DB_SSL=false
# Verify DB TLS certs. Set false on Render + Supabase Session pooler if you see
# SSLCertVerificationError: self-signed certificate in certificate chain.
DB_SSL_VERIFY=true

# --- JWT / session secrets ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_use_a_long_random_string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
PASSWORD_RESET_TTL_MINUTES=30

# --- Cookies ---
COOKIE_DOMAIN=                       # blank for localhost; e.g. .example.com in prod
COOKIE_SECURE=false                  # MUST be true in production (HTTPS only)
COOKIE_SAMESITE=lax                  # lax | strict | none  (none requires Secure=true)

# --- CORS (comma-separated origins allowed to send credentialed requests) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend base URL (used for OAuth redirects back into the SPA) ---
FRONTEND_URL=http://localhost:5173

# --- OAuth / SSO providers (leave blank to disable a provider) ---
# The callback URL to register with each provider is:
#   {BACKEND_URL}/api/auth/sso/{provider}/callback
BACKEND_URL=http://localhost:8000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Azure: use your tenant id, or "common" / "organizations"
AZURE_TENANT_ID=common
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Okta: your org domain, e.g. https://dev-12345.okta.com
OKTA_DOMAIN=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=

# --- Seed admin (created by seed.py) ---
SEED_ADMIN_EMAIL=admin@betterdental.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_SUPER_ADMIN_EMAIL=platform@nexhealth.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!

# --- AWS SES (transactional email) ---
# Set SES_ENABLED=true in production after verifying sender in SES.
SES_ENABLED=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=noreply@yourdomain.com
SES_FROM_NAME=NextHealth
INVITE_TTL_HOURS=72

# --- EHR Synchronizer ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EHR_CREDENTIALS_KEY=
# Must stay false — only real EHR APIs are used for patient import
EHR_SYNC_DEMO_MODE=false
# --- Open Dental (platform-level developer key from vendor.relations@opendental.com) ---
OPEN_DENTAL_DEVELOPER_KEY=
OPEN_DENTAL_API_BASE_URL=https://api.opendental.com

# --- Conversational intake agent (Milestone 3) ---
AGENT_ENABLED=true
# Prefer Azure OpenAI when both O3_* vars are set (recommended for clinic demos).
O3_ACCESS_TOKEN=
O3_BASE_URI=https://YOUR-RESOURCE.cognitiveservices.azure.com/openai/deployments/o3-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AI_ASSISTANT_NAME=Angelina
AGENT_DEFAULT_INTAKE_MODE=agent
# Fallback: public OpenAI (needs credits). Ignored if Azure O3_* is configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
